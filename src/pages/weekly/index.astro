---
import { getCollection } from 'astro:content'
import PageLayout from '@/layouts/PageLayout.astro'

const issues = await getCollection('weekly')
issues.sort((a, b) => b.data.weekStart.localeCompare(a.data.weekStart))
---

<PageLayout
  title="每周热点 · 深度梳理"
  description="AI驱动的热点事件分析与证据链梳理"
>
  <div class="max-w-3xl mx-auto px-4 py-16">
    <header class="mb-14">
      <p class="text-[10px] font-mono text-[var(--text-secondary)] tracking-[0.2em] uppercase">
        Weekly Intelligence Briefing
      </p>
      <h1 class="mt-3 text-2xl font-bold text-[var(--text-primary)] tracking-wide">
        每周热点 · 深度梳理
      </h1>
      <div class="mt-3 flex items-center gap-3">
        <span class="h-px flex-1 bg-[var(--border-primary)]" />
        <p class="text-xs text-[var(--text-secondary)] tracking-wide shrink-0">
          AI 筛选 · 证据驱动 · 溯源求真
        </p>
        <span class="h-px w-8 bg-[var(--border-primary)]" />
      </div>
    </header>

    {
      issues.length === 0 && (
        <div class="text-center py-20 text-sm text-[var(--text-secondary)]">
          暂无简报。运行 Python CLI 生成第一期。
        </div>
      )
    }

    <div class="space-y-4">
      {issues.map((issue, i) => {
        const totalTimeline = issue.data.events.reduce(
          (s, e) => s + e.timeline.length,
          0
        )
        const totalEvidence = issue.data.events.reduce(
          (s, e) => s + e.evidence.length,
          0
        )
        return (
          <a
            href={`/weekly/${issue.data.id}`}
            class="group block"
          >
            <article class="flex items-start gap-6 p-5 border border-[var(--border-primary)] hover:border-[var(--accent)] transition-colors">
              {/* Week number block */}
              <div class="shrink-0 w-16 text-right">
                <div class="text-[10px] font-mono text-[var(--text-secondary)] tracking-[0.15em] uppercase">
                  Issue
                </div>
                <div class="text-xl font-mono font-bold text-[var(--accent)] tabular-nums">
                  {issue.data.id.split('-W')[1]}
                </div>
              </div>

              {/* Content */}
              <div class="flex-1 min-w-0">
                <h2 class="text-base font-semibold text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors">
                  第 {issue.data.id.split('-W')[1]} 周简报
                </h2>
                <div class="mt-1.5 flex items-center gap-4 text-[11px] font-mono tabular-nums text-[var(--text-secondary)]">
                  <span>
                    {issue.data.weekStart} → {issue.data.weekEnd}
                  </span>
                  <span class="text-[var(--border-primary)]">|</span>
                  <span>{issue.data.events.length} 事件</span>
                  <span class="text-[var(--border-primary)]">|</span>
                  <span>{totalTimeline} 时间节点</span>
                  <span class="text-[var(--border-primary)]">|</span>
                  <span>{totalEvidence} 项证据</span>
                </div>
              </div>

              {/* Arrow */}
              <span class="shrink-0 text-[var(--text-secondary)] group-hover:text-[var(--accent)] group-hover:translate-x-1 transition-all text-lg mt-1">
                →
              </span>
            </article>
          </a>
        )
      })}
    </div>
  </div>
</PageLayout>
