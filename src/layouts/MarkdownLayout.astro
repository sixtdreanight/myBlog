---
import Layout from './Layout.astro'
import { HeadGradient } from '@/components/head-gradient'
import Footer from '@/components/footer/Footer.astro'
import { Header } from '@/components/header/Header'
import { Provider } from '@/components/provider/Provider'
import { author } from '@/config.json'
import 'katex/dist/katex.min.css'

interface Props {
  title: string
  description?: string
  image?: string
  mdTitle: string
  mdDescription: string
  mdSlug: string
}

const { title, description, image, mdTitle, mdDescription, mdSlug } = Astro.props
---

<Layout title={title} description={description} image={image}>
  <Provider
    pathName={Astro.url.pathname}
    title={mdTitle}
    description={mdDescription}
    slug={mdSlug}
    client:only="react"
  />

  <!-- SSR placeholder — replaced when React Header hydrates -->
  <header class="fixed top-0 inset-x-0 h-[64px] z-10 flex items-center justify-center bg-white/70 dark:bg-zinc-800/70 backdrop-blur-lg border-b border-primary">
    <a href="/" title="Home" class="size-[40px]">
      <img class="size-[40px] select-none object-cover rounded-2xl" src={author.avatar} alt={author.name} />
    </a>
  </header>
  <Header client:only="react" />
  <main class="relative z-1 pt-16 min-h-main bg-primary">
    <HeadGradient client:idle />
    <div class="swup-transition-fade">
      <slot />
    </div>
  </main>
  <Footer />
</Layout>
